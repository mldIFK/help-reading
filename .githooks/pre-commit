#!/bin/sh
#
# Refuse le commit tant que la suite de tests n'est pas verte et que le projet
# ne compile pas.
#
# Les deux verifications sont complementaires : les tests couvrent les regles
# metier, la compilation attrape ce qu'aucun test n'importe — typiquement une
# erreur de syntaxe dans un ecran purement visuel.
#
# Ce garde-fou est la contrepartie mecanique des regles decrites dans
# .claude/skills/regles-de-code/SKILL.md : les regles ecrites s'oublient, un
# commit refuse, non.
#
# Ce fichier est versionne avec le projet et active par `core.hooksPath`
# (voir le script `prepare` de package.json), afin qu'il suive le depot lors
# d'un clone — ce que ne fait jamais le dossier .git/hooks.

set -e

repository_root=$(git rev-parse --show-toplevel)
cd "$repository_root"

refuse_commit() {
  echo ""
  echo "=================================================================="
  echo " COMMIT REFUSE : $1"
  echo ""
  echo " Corrige le probleme, puis recommence le commit."
  echo " Regles du projet : .claude/skills/regles-de-code/SKILL.md"
  echo "=================================================================="
  echo ""
  exit 1
}

if [ ! -d node_modules ]; then
  refuse_commit "les dependances ne sont pas installees (lance : npm install)."
fi

echo ""
echo "--- 1/2  Suite de tests ---------------------------------------"
echo ""
npm test || refuse_commit "des tests echouent."

echo ""
echo "--- 2/2  Compilation du projet --------------------------------"
echo ""
npm run build || refuse_commit "la compilation echoue."

echo ""
echo "Tests verts et compilation reussie : commit autorise."
echo ""
